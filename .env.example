# ============================================================
#  OpenClaw — стенд для тестового задания
#  Скопируйте в .env и подставьте свои значения.
#  .env в git НЕ попадает (см. .gitignore).
# ============================================================

# --- Версия образа ---
# На стенде развёрнут тег latest, на момент сдачи это OpenClaw 2026.7.1.
# Для полностью воспроизводимой установки подставьте конкретный тег.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# --- Секреты ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Ключ OrcaRouter (https://www.orcarouter.ai) — используется бесплатный тир
ORCAROUTER_API_KEY=sk-orca-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Токен доступа к Gateway API/Control UI (сгенерировать: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=

# --- ЭТАП 2: обход блокировки Telegram без VPN ---
# DNS отдаёт api.telegram.org -> 149.154.166.110, этот адрес из РФ заблокирован.
# Живой адрес подставляется напрямую в /etc/hosts контейнера (extra_hosts).
# Значение поддерживается в актуальном состоянии скриптом scripts/tg-ip-watchdog.sh
TELEGRAM_API_IP=149.154.167.220

# --- Сеть: публикуем ТОЛЬКО на localhost ---
# VPS публичный, Control UI не должен торчать в интернет.
# Доступ к панели — через SSH-туннель: ssh -L 18789:127.0.0.1:18789 <host>
OPENCLAW_GATEWAY_PORT=127.0.0.1:18789
OPENCLAW_BRIDGE_PORT=127.0.0.1:18790
OPENCLAW_MSTEAMS_PORT=127.0.0.1:3978
# Внутри контейнера слушаем 0.0.0.0, иначе проброс порта не работает
OPENCLAW_GATEWAY_BIND=lan

# --- Пути хранения состояния ---
OPENCLAW_CONFIG_DIR=/opt/openclaw-stand/data/config
OPENCLAW_WORKSPACE_DIR=/opt/openclaw-stand/data/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/opt/openclaw-stand/data/auth-secrets

# --- Прочее ---
OPENCLAW_TZ=Europe/Moscow
# Лимит памяти: на VPS всего 2 ГБ и рядом работают другие сервисы
OPENCLAW_MEM_LIMIT=1024m
